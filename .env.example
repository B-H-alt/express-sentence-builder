# Browser-safe values. Add these only after a Supabase development project exists.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Matching server-side public values used to verify signed-in parents.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret for Vercel Functions. Never prefix this with VITE_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Existing server-only image-generation secret.
REPLICATE_API_TOKEN=
