# Browser-safe values. Add these only after a Supabase development project exists.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser-safe Cloudflare Turnstile site key. The matching secret is configured
# only in Supabase Auth, never in this repository or Vercel's VITE_ variables.
VITE_TURNSTILE_SITE_KEY=

# Matching server-side public values used to verify signed-in parents.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret for Vercel Functions. Never prefix this with VITE_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Existing server-only image-generation secret.
REPLICATE_API_TOKEN=

# Server-only premium voice credentials. Never prefix either with VITE_.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
